# 申請改防線本身的檔案 (hook、agent 設定、CI、檢查的設定), 一定要使用者確認
# (Codex 的 PreToolUse hook 不支援 ask, 由這條規則補上)。寫法固定, 換寫法呼叫會被
# .agents/hooks/guard_commands.py 擋下。說明見 docs/extending/agent-hooks.md。
prefix_rule(
    pattern = ["python3", ".agents/hooks/approve_protected_edit.py"],
    decision = "prompt",
    match = ["python3 .agents/hooks/approve_protected_edit.py .github/workflows/ci.yml"],
    not_match = ["python3 .agents/hooks/approve_test_edit.py apps/api/tests/test_docs.py"],
)
