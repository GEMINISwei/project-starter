# 環境變數清單, 也是 `make init` 產生 `.env` 的範本: 它複製這份, 再填入問到的值與
# 標「自動產生」的祕密, 所以這裡的註解會原樣出現在 `.env` 裡。
# 新增變數的同步點見 docs/development.md〈環境變數的同步點〉。
# 註解只能寫在上一行: `KEY=  # 說明` 的整串 `# 說明` 會被當成值。

# ── Project ──────────────────────────────────────────────────────────────────
# production 或 development, make init dev|prod 會設定。決定 compose 疊哪份 overlay、
# volume 的名稱, 以及正式主機上不能跑的指令
MODE=
# 容器與 volume 的前綴, 只能用小寫英數與 - _
COMPOSE_PROJECT_NAME=my-app
# 顯示在側欄與 PWA 上的名稱
SYSTEM_NAME=My App
# 對外唯一的 port (nginx)
SYSTEM_PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# 自動產生, 只能用英數與 . _ ~ - (會被插進連線 URL)。帳號與資料庫名稱固定是 app (寫在 compose)。
# 只在第一次建立資料庫時生效: 之後改這裡不會改到資料庫裡的密碼, 只會讓 api 連不上
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# 自動產生, 至少 32 字元
JWT_SECRET_KEY=
# 登入後幾小時一定要重新登入 (不會續期)。必填, 前後端用同一個值
EXPIRE_HOURS=8

# ── App ───────────────────────────────────────────────────────────────────────
# 自動產生。Server Action 的加密金鑰, 執行期注入。改了要重建容器才生效 (make services restart
# 不會套用, 見 docs/operations.md〈套用 .env 的變更〉), 開著的分頁要重新整理
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
