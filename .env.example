# 這份檔案是**清單**，不是拿來複製的範本。
#
# 實際的 `.env` 請用 `make init` 產生 —— 它會互動式詢問專案名稱、port 與資料庫帳密，
# 並以 `openssl rand` 產生底下標成「自動產生」的那幾個祕密。手抄這份檔案很容易
# 漏掉那些，而漏掉的後果是服務照常啟動、但簽出的 token 任何人都能偽造。
#
# 這裡的用途是讓人在不啟動任何東西的情況下，看得到「這個系統吃哪些環境變數」——
# 這份檔案就是那份清單的唯一出處，**不要另外抄一份到 docs/**。
# 新增環境變數時，`app/config.py`（後端讀取）、`infra/docker/docker-compose.yml`（注入）、
# `scripts/init.sh`（產生 .env）與這份檔案都要一起更新。
# `make check-env` 會比對後三者的變數集合與預設值，漏掉或值飄掉都會紅燈。
#
# `MODE` 不在這裡：`make dev` 用 development、`make prod` 用 production，由腳本決定。

# ── Project ──────────────────────────────────────────────────────────────────
# compose 專案名稱，決定容器與 volume 的前綴。只能用小寫英數與 - _。
COMPOSE_PROJECT_NAME=my-app
# 顯示在側欄與 PWA 名稱上的系統名稱。
SYSTEM_NAME=My App
# 對外唯一 publish 的 port（nginx）。後端與資料庫都只在 compose 內網。
SYSTEM_PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=         # 必填
# 資料庫名稱。compose 會用它建 volume 與 DB，API 的連線字串也由它組出來。
POSTGRES_DB=app

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT 簽章金鑰。**自動產生**（openssl rand -hex 32，長度 64）。
# 下限 32 字元由 app/config.py 檢查，太短會在啟動當下失敗而不是默默變弱。
JWT_SECRET_KEY=
# access token 有效時數，同時決定 cookie 的 maxAge。
# 這是**硬上限**：沒有續期機制，時間到就一定要重新登入，跟使用者當下有沒有在操作無關
#（見 docs/operations.md「Session 不會續期」）。設太短會讓人填到一半的表單被踢掉。
EXPIRE_HOURS=8
# 只用來決定「既有 token 是否全部失效」。要強制全站重新登入時 +1。
TOKEN_VERSION=1

# ── App ───────────────────────────────────────────────────────────────────────
# 建立第一個超級管理者用的系統密碼。整個部署只能成功一次，之後可留空。
# **留空代表停用**「以系統密碼註冊超級管理者」這條路徑（見 modules/users/service.py）。
# 要再新增超級管理者請用 `make create-superuser`。
REGISTER_KEY=
# Next.js 的上傳大小上限（Server Action body）。nginx 的 `client_max_body_size` 是
# 另一個值、寫死在 infra/nginx/templates/ 裡 —— 兩者格式不同，刻意不共用（理由見該檔）。
#
# 這個值**在 build 期定案**（Next 把它序列化進 .next/required-server-files.json），
# 改了必須重建 image。改了但沒重建時 web 會在啟動時印出原因並**結束行程**
# （apps/web/instrumentation.ts），不會靜靜地沿用舊上限。
UPLOAD_SIZE_LIMIT=1mb
# Server Action id 的 hash salt。**自動產生**。
# 留空的話 Next 每次 build／每次 dev server 啟動都會亂數換一把，所有 id 跟著換，
# 使用者開著沒重載的分頁會出現「Server Action ... was not found on the server」。
# 改這個值必須 `make prod` 重建 image —— prod 的值是 build 期烤進去的。
#
# **走 registry（make deploy）時，這個值必須同時存在於 GitHub 的
# `NEXT_SERVER_ACTIONS_ENCRYPTION_KEY` secret**：image 由 CI 建置，主機這一份不會生效。
# 這是整份清單裡唯一一個 `make check-env` 守不到的同步點，理由與代價見
# docs/operations.md「registry 模式的兩個 build 期值」。
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Push（VAPID）─────────────────────────────────────────────────────────────
# Web Push 的金鑰組，**自動產生**（`make init`），也可自行以 web-push 工具產生一組。
#
# 直接執行後端行程時，留空會讓 NotificationDispatcher 靜默略過推播，
# 前端的通知設定顯示為未啟用（見 app/config.py）。
# **但 docker-compose.yml 把三個都設為必填**（`${VAPID_*:?}`），所以走 `make dev`／
# `make prod` 一定要有值 —— 留空不會變成「停用推播」，而是 compose 直接失敗。
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Deploy（選用）─────────────────────────────────────────────────────────────
# 這一組**不會進到任何容器**，只有 `scripts/deploy.sh` 在主機上讀
# （所以它們列在 check-env.sh 的 HOST_ONLY 裡）。
#
# Container registry 前綴，例如 ghcr.io/<owner>/<repo>。image 名稱由它組成：
# `<IMAGE_REGISTRY>/api:<IMAGE_TAG>` 與 `<IMAGE_REGISTRY>/web:<IMAGE_TAG>`。
# **留空 = 不使用 registry**，走 `make prod` 在主機上就地建置（模板出廠的行為）。
# **一律全小寫**：CI 推的是 metadata-action 自動轉小寫的名字，而 deploy.sh 這一側是純字串
# 串接、不做 normalize。owner 或 repo 名含大寫時照字面抄，會得到 invalid reference format，
# 而那句話不會告訴你要回來改這一行。
IMAGE_REGISTRY=
# 要部署的 image tag。`make deploy` 用它；CD 走 `bash scripts/deploy.sh <tag>`，
# 參數會蓋過這裡的值 —— 部署哪一版不該取決於主機上那份 .env 的殘值。
IMAGE_TAG=
