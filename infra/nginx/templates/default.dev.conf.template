map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    absolute_redirect off;

    resolver 127.0.0.11 valid=10s;

    # 與 default.conf.template（production）保持一致，確保開發與正式環境使用相同的
    # 用戶端 IP 傳遞方式（由 `make check-nginx` 守著）。
    client_max_body_size 16m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # 追蹤識別碼：底下每個 proxy 目標都以 `$request_id` **覆寫** X-Request-ID，
    # 理由與完整的串接方式見 default.conf.template 的同一段註解。

    # WebSocket endpoint
    location /api/ws {
        set $backend_upstream http://api:8000;
        proxy_pass         $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host       $host;
        proxy_set_header   X-Request-ID    $request_id;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering    off;
    }

    # 這裡刻意**沒有** `location /api/`（同 default.conf.template，理由見該檔的同一段）。
    # dev 與 prod 在這件事上必須一致 —— 只在 dev 留一條對外的 API 路徑，等於讓開發時
    # 寫得出「瀏覽器直接打後端」的程式，然後在 prod 才壞掉。

    # Next.js HMR（dev only）
    #
    # 路徑名稱由 Next 決定，且**升級時會改**（16.3 把 `/_next/webpack-hmr` 換成
    # `/_next/hmr`）。名稱對不上不會有任何錯誤：請求會落到下面的 `location /`，
    # 那裡沒有 upgrade 標頭，於是 dev server 收到一個普通 GET 並回 404，
    # 瀏覽器只會說 "There was a bad response from the server"，然後熱更新安靜地死掉。
    # 升 Next 後若改動沒有自動反映，先確認這個路徑。
    location /_next/hmr {
        set $frontend_upstream http://web:3000;
        proxy_pass         $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host       $host;
    }

    # Frontend
    location / {
        set $frontend_upstream http://web:3000;
        proxy_pass         $frontend_upstream;
        proxy_set_header   Host              $http_host;
        # 覆寫而非附加（$proxy_add_x_forwarded_for），理由見 default.conf.template 的同一段註解。
        proxy_set_header   X-Request-ID      $request_id;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
