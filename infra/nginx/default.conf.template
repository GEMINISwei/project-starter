server {
    listen 80;

    resolver 127.0.0.11 valid=10s;

    # ── 請求體大小上限 ────────────────────────────────────────────────────────
    #
    # 粗粒度的 DoS 護欄。刻意比應用層的 UPLOAD_SIZE_LIMIT 寬鬆, 讓超過業務限制的請求
    # 拿到應用層帶訊息的錯誤, 而不是 nginx 的 413。兩者格式不同, 不要共用變數。
    client_max_body_size 16m;

    include /etc/nginx/snippets/security-headers.conf;

    # ── 刻意**沒有** `location /api/` ─────────────────────────────────────────
    #
    # 瀏覽器不直接呼叫後端: 讀取走 Server Component、寫入走 Server Action, 都在 Next 的
    # 伺服器端經 compose 內網連 api。加回 `/api/` 等於把每條後端路由對外曝露;
    # 需要從瀏覽器呼叫時, 在模組的 actions.ts 包一層具名的 Server Action。
    # 需要 WebSocket 時補一條專屬 location (連同 `map $http_upgrade`), 不是開放整個 /api/。
    #
    # 另一半在 next.config.ts (那裡也沒有 `/api/:path*` rewrite), 兩處要一起看。

    # Frontend (含 Next.js static assets)
    location / {
        set $frontend_upstream http://web:3000;
        proxy_pass $frontend_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
